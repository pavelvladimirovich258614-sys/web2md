# web2md — environment configuration.
# Copy to ".env" and fill in your own values.

# --- Telegram bot (required to run bot.py) ---
# Get it from @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# --- web2md engine defaults ---
# Max characters of Markdown returned per page (bot & crew)
WEB2MD_MAX_LEN=6000
# HTTP fetch timeout in seconds
WEB2MD_TIMEOUT=20
# Hard cap on a single Telegram reply (the message is split above this)
TG_MAX_REPLY=4000

# --- CrewAI / LLM (optional; needed only for crew_pipeline.py and /summary) ---
# Any OpenAI-compatible key. CrewAI reads OPENAI_API_KEY by default.
OPENAI_API_KEY=
# Model id used by the research crew (default: gpt-4o-mini)
CREW_MODEL=gpt-4o-mini
